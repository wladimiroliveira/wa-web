// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`routes > declares the guards of every screen 1`] = `
"/ -> SESSION
/change-password -> SESSION
/entries -> SESSION > ENTRIES_CREATE > CATALOG_READ
/login -> (none)
/loss-reasons -> SESSION > LOSSES_UPDATE
/pre-weighings -> SESSION > PRODUCTION_READ
/pre-weighings/:id -> SESSION > PRODUCTION_READ
/pre-weighings/new -> SESSION > PRODUCTION_READ > PRODUCTION_CREATE > CATALOG_READ
/products -> SESSION > CATALOG_READ
/recipes -> SESSION > CATALOG_READ > CATALOG_UPDATE
/roles -> SESSION > ACCESS_READ
/stock -> SESSION > REPORTS_READ
/stock-movements -> SESSION > ENTRIES_READ
/stock/:sku -> SESSION > REPORTS_READ
/suppliers -> SESSION > CATALOG_READ"
`;
